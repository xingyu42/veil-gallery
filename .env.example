# 从 Upstash Console 复制以下值
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# 可选：Resin 原生反代 HTTPS 前缀（包含 Token，按 Vercel Secret 管理）
# RESIN_IMAGE_PROXY_BASE_URL=https://resin.example.com/<token>/Default/https/veil.ortlinde.com

# 可选：整个图片代理池每 300 秒允许的实际回源尝试数（默认 100）
# IMAGE_PROXY_RATE_LIMIT=300

# 手工触发 /api/calibrate-offset 的必填随机密钥
# CRON_SECRET=replace-with-a-long-random-secret

# 可选：边界记录和自动二分都不可用时的未验证兜底
# GALLERY_START_OFFSET=76046
